PORT=5000
NODE_ENV=development
# Create a database in MongoDB Atlas or run MongoDB locally, then paste the URI below.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/smart_health?retryWrites=true&w=majority
# Optional comma-separated list. Vite default is http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
